model OutgoingWebhookDelivery {
  id        String @id @default(cuid())
  webhookId String @map("webhook_id")
  webhook   OutgoingWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  eventType String @map("event_type") // Type of event sent
  payload   Json // Event payload

  status OutgoingWebhookStatus
  statusCode Int? @map("status_code") // HTTP status code
  responseBody String? @map("response_body") @db.Text // Response from server
  errorMessage String? @map("error_message") @db.Text // Error if failed

  attemptNumber Int @default(1) @map("attempt_number") // Retry attempt number
  deliveredAt DateTime? @map("delivered_at") // When delivered successfully

  createdAt DateTime @default(now()) @map("created_at")

  @@index([webhookId])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@map("outgoing_webhook_deliveries")
}



