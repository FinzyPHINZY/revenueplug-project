

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  email    String?
  settings Json?


  stripeCustomerId       String?                  @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?                  @unique @map("stripe_subscription_id")
  stripePriceId          String?                  @map("stripe_price_id")
  billingStatus          BillingStatus?           @default(FREE) @map("billing_status")
  currentPeriodStart     DateTime?                @map("current_period_start")
  currentPeriodEnd       DateTime?                @map("current_period_end")
  cancelAtPeriodEnd      Boolean                  @default(false) @map("cancel_at_period_end")
  trialEnd               DateTime?                @map("trial_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  members           OrganizationMember[]
  connections       Connection[]
  usageTracking     UsageTracking[]
  billingEvents     BillingWebhookEvent[]
  recoveryCredit    FirstRecoveryCredit?
  retentionStrategies RetentionStrategy[]
  campaigns         Campaign[]
  emailTemplates    EmailTemplate[]
  campaignMetrics   CampaignMetrics[]
  emailPreferences  EmailPreference[]
  campaignSchedules CampaignSchedule[]
  zapierWebhooks    ZapierWebhook[]
  auditLogs         AuditLog[]
  organizationSettings OrganizationSettings?
  outgoingWebhooks  OutgoingWebhook[]
  apiKeys           APIKey[]

  @@index([slug])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@map("organization_members")
}

model Connection {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  platform Platform         @map("platform")
  authType AuthType         @map("auth_type")
  status   ConnectionStatus @default(ACTIVE)




  credentials Json



  metadata Json?


  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  subscriptions Subscription[]
  customers     Customer[]
  payments      Payment[]
  invoices      Invoice[]

  @@unique([organizationId, platform])
  @@index([organizationId])
  @@index([platform])
  @@index([status])
  @@map("connections")
}

model UsageTracking {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  period         DateTime


  apiCalls    Int @default(0) @map("api_calls")
  emailsSent  Int @default(0) @map("emails_sent")
  connections Int @default(0)


  lastUpdatedAt DateTime @updatedAt @map("last_updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  @@unique([organizationId, period])
  @@index([organizationId])
  @@index([period])
  @@map("usage_tracking")
}

model BillingWebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  stripeEventId  String    @unique @map("stripe_event_id")
  eventType      String    @map("event_type")
  processed      Boolean   @default(false)
  processedAt    DateTime? @map("processed_at")
  error          String?
  payload        Json

  createdAt DateTime @default(now()) @map("created_at")


  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeEventId])
  @@index([organizationId])
  @@index([eventType])
  @@index([processed])
  @@map("billing_webhook_events")
}

model FirstRecoveryCredit {
  id             String       @id @default(cuid())
  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  paymentExternalId  String   @map("payment_external_id")
  customerExternalId String   @map("customer_external_id")
  recoveredAmount    Decimal  @map("recovered_amount")
  platform           Platform


  creditAmount Int                       @default(1000) @map("credit_amount")
  status       FirstRecoveryCreditStatus @default(PENDING)


  stripeCreditBalanceTransactionId String?   @unique @map("stripe_credit_balance_transaction_id")
  appliedAt                        DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("first_recovery_credits")
}


model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String?


  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")


  pendingEmail    String?   @map("pending_email")


  deletedAt       DateTime? @map("deleted_at")
  deleteToken     String?   @map("delete_token")


  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")


  sessions                Session[]
  verificationTokens      VerificationToken[]
  oauthAccounts           OAuthAccount[]
  organizationMemberships OrganizationMember[]
  notificationPreference  UserNotificationPreference?
  mfa                     UserMFA?

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)


  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")


  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  device       String?
  location     String?


  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String                 @id @default(cuid())
  userId    String                 @map("user_id")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)


  token     String                 @unique
  type      VerificationTokenType


  expiresAt DateTime               @map("expires_at")
  usedAt    DateTime?              @map("used_at")

  createdAt DateTime               @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)


  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")


  accessToken       String?       @map("access_token")
  refreshToken      String?       @map("refresh_token")
  expiresAt         DateTime?     @map("expires_at")


  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum OAuthProvider {
  GOOGLE
  SLACK
  MICROSOFT

  @@map("oauth_provider")
}

model UserMFA {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)


  secret         String


  enabled        Boolean   @default(false)
  verifiedAt     DateTime? @map("verified_at")
  lastUsedAt     DateTime? @map("last_used_at")


  recoveryCodes  String[]  @map("recovery_codes")


  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_mfa")
}


model Customer {
  id           String     @id @default(cuid())
  connectionId String     @map("connection_id")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)


  externalId String  @map("external_id")
  email      String?
  name       String?


  platform Platform


  rawData Json @map("raw_data")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  subscriptions        Subscription[]
  healthScores         CustomerHealthScore[]
  churnRiskScores      ChurnRiskScore[]
  campaigns            Campaign[]
  campaignCooldowns    CampaignCooldown[]
  emailPreferences     EmailPreference[]


  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([email])
  @@map("customers")
}

model Subscription {
  id           String     @id @default(cuid())
  connectionId String     @map("connection_id")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)


  externalId       String             @map("external_id")
  status           SubscriptionStatus
  currentPeriodEnd DateTime           @map("current_period_end")


  amount   Decimal
  currency String


  trialEnd      DateTime? @map("trial_end")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelAtEnd   Boolean   @default(false) @map("cancel_at_end")
  productName   String?   @map("product_name")
  productId     String?   @map("product_id")
  interval      String?
  intervalCount Int?      @default(1) @map("interval_count")


  platform Platform


  rawData Json @map("raw_data")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([customerId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id           String     @id @default(cuid())
  connectionId String     @map("connection_id")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)


  externalId String        @map("external_id")
  status     PaymentStatus


  amount   Decimal
  currency String


  subscriptionExternalId String?   @map("subscription_external_id")
  customerExternalId     String?   @map("customer_external_id")
  failureReason          String?   @map("failure_reason")
  paidAt                 DateTime? @map("paid_at")
  refundedAt             DateTime? @map("refunded_at")
  refundedAmount         Decimal?  @map("refunded_amount")


  platform Platform


  rawData Json @map("raw_data")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([status])
  @@index([subscriptionExternalId])
  @@index([customerExternalId])
  @@index([paidAt])
  @@map("payments")
}

model Invoice {
  id           String     @id @default(cuid())
  connectionId String     @map("connection_id")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)


  externalId String        @map("external_id")
  status     InvoiceStatus


  subscriptionExternalId String? @map("subscription_external_id")
  customerExternalId     String? @map("customer_external_id")


  amountDue       Decimal  @map("amount_due")
  amountPaid      Decimal  @default(0) @map("amount_paid")
  amountRemaining Decimal  @map("amount_remaining")
  currency        String


  dueDate            DateTime? @map("due_date")
  paidAt             DateTime? @map("paid_at")
  nextPaymentAttempt DateTime? @map("next_payment_attempt")


  attemptCount  Int     @default(0) @map("attempt_count")
  failureReason String? @map("failure_reason")


  hostedInvoiceUrl String? @map("hosted_invoice_url")
  invoicePdf       String? @map("invoice_pdf")


  platform Platform


  rawData Json @map("raw_data")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([status])
  @@index([subscriptionExternalId])
  @@index([customerExternalId])
  @@index([dueDate])
  @@index([nextPaymentAttempt])
  @@map("invoices")
}


model EventOutbox {
  id String @id @default(cuid())


  eventType      String   @map("event_type")
  organizationId String   @map("organization_id")
  platform       Platform


  payload Json


  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  createdAt DateTime @default(now())

  @@index([published])
  @@index([createdAt])
  @@index([organizationId])
  @@map("event_outbox")
}


enum Platform {
  STRIPE
  POLAR
  REVENUECAT
  LEMON_SQUEEZY

  @@map("platform")
}

enum AuthType {
  OAUTH
  API_KEY
  WEBHOOK_ONLY

  @@map("auth_type")
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  FAILED
  DISCONNECTED

  @@map("connection_status")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  PAUSED
  INCOMPLETE
  UNPAID

  @@map("subscription_status")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@map("invoice_status")
}


model WebhookEvent {
  id        String   @id @default(cuid())


  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")


  connectionId String? @map("connection_id")


  status       WebhookEventStatus @default(PENDING)
  processedAt  DateTime?          @map("processed_at")
  errorMessage String?            @map("error_message")


  payload Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stripeEventId])
  @@index([eventType])
  @@index([connectionId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("webhook_event_status")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_token_type")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("organization_role")
}

enum BillingStatus {
  FREE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID

  @@map("billing_status")
}

enum FirstRecoveryCreditStatus {
  PENDING
  APPLIED
  EXPIRED

  @@map("first_recovery_credit_status")
}


model EnterpriseLead {
  id String @id @default(cuid())


  name            String
  email           String
  company         String
  jobTitle        String?  @map("job_title")
  phone           String?
  website         String?
  linkedinUrl     String?  @map("linkedin_url")


  monthlyRevenue       Int?     @map("monthly_revenue")
  customerCount        Int?     @map("customer_count")
  platformsUsed        String[] @map("platforms_used")
  currentFailureRate   Float?   @map("current_failure_rate")
  estimatedAtRisk      Int?     @map("estimated_at_risk")


  qualificationScore Int                  @default(0) @map("qualification_score")
  qualificationTier  LeadQualificationTier @map("qualification_tier")
  isQualified        Boolean              @default(false) @map("is_qualified")


  source     LeadSource @default(CONTACT_FORM)
  utmSource  String?    @map("utm_source")
  utmMedium  String?    @map("utm_medium")
  utmCampaign String?   @map("utm_campaign")
  referrer   String?


  message             String? @db.Text
  interestedFeatures  String[] @map("interested_features")
  timeline            String?
  hasExistingAccount  Boolean  @default(false) @map("has_existing_account")
  organizationId      String?  @map("organization_id")


  status              LeadStatus            @default(NEW)
  assignedTo          String?               @map("assigned_to")
  scheduledCallAt     DateTime?             @map("scheduled_call_at")
  proposalSentAt      DateTime?             @map("proposal_sent_at")
  contractSentAt      DateTime?             @map("contract_sent_at")
  closedAt            DateTime?             @map("closed_at")
  closedReason        String?               @map("closed_reason")


  estimatedDealValue  Int?     @map("estimated_deal_value")
  proposedPricing     Json?    @map("proposed_pricing")


  notes               String? @db.Text
  communicationLog    Json[]  @default([]) @map("communication_log")


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([qualificationTier])
  @@index([isQualified])
  @@index([createdAt])
  @@index([organizationId])
  @@map("enterprise_leads")
}

enum LeadQualificationTier {
  HOT
  WARM
  COLD
  UNQUALIFIED

  @@map("lead_qualification_tier")
}

enum LeadSource {
  CONTACT_FORM
  IN_APP_UPGRADE
  BLOCKED_CHECKOUT
  REFERRAL
  WEBSITE
  WEBINAR
  CONFERENCE
  OUTBOUND

  @@map("lead_source")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
  NURTURE

  @@map("lead_status")
}


model CustomerHealthScore {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)


  score Int


  paymentHealthScore     Int @map("payment_health_score")
  engagementScore        Int @map("engagement_score")
  usageScore             Int @map("usage_score")
  subscriptionHealthScore Int @map("subscription_health_score")
  supportScore           Int @map("support_score")


  riskLevel    HealthRiskLevel @map("risk_level")
  riskFactors  String[]        @map("risk_factors")


  trend        ScoreTrend
  previousScore Int?           @map("previous_score")
  scoreChange   Int?           @map("score_change")


  calculatedAt DateTime @default(now()) @map("calculated_at")
  expiresAt    DateTime @map("expires_at")


  breakdown Json?

  @@index([customerId])
  @@index([score])
  @@index([riskLevel])
  @@index([calculatedAt])
  @@map("customer_health_scores")
}

model ChurnRiskScore {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)


  score Int


  riskLevel ChurnRiskLevel @map("risk_level")


  paymentFailureRisk    Int @map("payment_failure_risk")
  engagementDeclineRisk Int @map("engagement_decline_risk")
  usageDeclineRisk      Int @map("usage_decline_risk")
  supportIssueRisk      Int @map("support_issue_risk")


  churnSignals String[] @map("churn_signals")


  predictedChurnDate    DateTime? @map("predicted_churn_date")
  churnProbability      Float     @map("churn_probability")
  daysUntilPredictedChurn Int?    @map("days_until_predicted_churn")


  recommendedActions String[] @map("recommended_actions")
  priority           ActionPriority


  calculatedAt DateTime @default(now()) @map("calculated_at")
  expiresAt    DateTime @map("expires_at")


  previousScore Int?       @map("previous_score")
  trend         ScoreTrend

  @@index([customerId])
  @@index([riskLevel])
  @@index([score])
  @@index([calculatedAt])
  @@index([priority])
  @@map("churn_risk_scores")
}


model RetentionStrategy {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  name        String
  description String? @db.Text
  status      RetentionStrategyStatus @default(ACTIVE)



  triggerConditions Json @map("trigger_conditions")



  audienceFilters Json? @map("audience_filters")


  actions Json[] @default([])


  cooldownDays Int @default(30) @map("cooldown_days")
  maxActionsPerCustomer Int @default(5) @map("max_actions_per_customer")


  priority ActionPriority @default(MEDIUM)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  campaigns Campaign[]
  cooldowns CampaignCooldown[]
  metrics   CampaignMetrics[]
  schedules CampaignSchedule[]

  @@index([organizationId])
  @@index([status])
  @@map("retention_strategies")
}

model Campaign {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  strategyId String           @map("strategy_id")
  strategy   RetentionStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)


  status      CampaignStatus @default(ACTIVE)
  priority    ActionPriority
  triggerType CampaignTriggerType @map("trigger_type")



  triggerContext Json @map("trigger_context")


  convertedAt DateTime? @map("converted_at")
  revenueRecovered Decimal? @map("revenue_recovered") @db.Decimal(10, 2)


  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelReason String?  @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  actions   CampaignAction[]
  cooldowns CampaignCooldown[]

  @@index([organizationId])
  @@index([strategyId])
  @@index([customerId])
  @@index([status])
  @@index([triggerType])
  @@index([startedAt])
  @@map("campaigns")
}


model CampaignAction {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)


  actionType ActionType @map("action_type")
  status     CampaignActionStatus @default(PENDING)


  delayMinutes Int @default(0) @map("delay_minutes")
  scheduledFor DateTime @map("scheduled_for")


  sequenceId    String?  @map("sequence_id")
  sequenceStep  Int?     @map("sequence_step")
  parentActionId String? @map("parent_action_id")


  branchCondition     String? @map("branch_condition")
  branchFromActionId  String? @map("branch_from_action_id")





  actionData Json @map("action_data")


  executedAt DateTime? @map("executed_at")
  executionResult Json?   @map("execution_result")



  errorMessage String? @map("error_message")
  retryCount   Int     @default(0) @map("retry_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([status])
  @@index([scheduledFor])
  @@index([actionType])
  @@map("campaign_actions")
}



model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  name        String
  description String? @db.Text
  category    EmailTemplateCategory
  status      EmailTemplateStatus @default(ACTIVE)


  subject     String
  htmlBody    String  @db.Text @map("html_body")
  textBody    String? @db.Text @map("text_body")



  availableTags String[] @map("available_tags")


  variantOf   String?  @map("variant_of")
  variantName String?  @map("variant_name")


  sentCount       Int @default(0) @map("sent_count")
  openRate        Float? @map("open_rate")
  clickRate       Float? @map("click_rate")
  conversionRate  Float? @map("conversion_rate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([category])
  @@index([status])
  @@map("email_templates")
}



model CampaignMetrics {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  strategyId String?          @map("strategy_id")
  strategy   RetentionStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)


  period     DateTime
  periodType MetricPeriod @map("period_type")


  totalCampaigns       Int @default(0) @map("total_campaigns")
