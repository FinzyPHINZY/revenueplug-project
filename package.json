{
  "name": "revenueplug",
  "version": "0.1.0",
  "description": "Revenue recovery co-pilot for subscription-based businesses",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:setup:live": "tsx scripts/stripe-setup.ts --live",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/billing/webhook"
  },
  "keywords": [
    "saas",
    "revenue",
    "subscription",
    "churn",
    "stripe",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.7.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@hubspot/api-client": "^13.4.0",
    "@prisma/client": "^5.22.0",
    "arctic": "^3.7.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.28.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mixpanel": "^0.19.1",
    "otplib": "^13.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "resend": "^6.6.0",
    "stripe": "^20.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
