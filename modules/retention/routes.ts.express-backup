    if (template.organizationId !== req.user?.organizationId) {
      return res.status(403).json({ error: 'Forbidden' });
    }

    res.json(template);
  } catch (error) {
    log.error({ error }, 'Failed to get template');
    res.status(500).json({ error: 'Failed to get template' });
  }
});

