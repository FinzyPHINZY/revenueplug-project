// RETENTION STRATEGIES
// ============================================================================

/**
 * POST /api/retention/strategies
 * Create a new retention strategy
 */
router.post('/strategies', async (req: Request, res: Response) => {
  try {
    const organizationId = req.user?.organizationId; // Assumes auth middleware sets req.user

    if (!organizationId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const strategy = await createStrategy({
      organizationId,
      ...req.body,
    });

    res.status(201).json(strategy);
  } catch (error) {
    log.error({ error }, 'Failed to create strategy');
    res.status(500).json({ error: 'Failed to create strategy' });
  }
});

/**
 * GET /api/retention/strategies
 * List all strategies for the organization
 */
router.get('/strategies', async (req: Request, res: Response) => {
  try {
    const organizationId = req.user?.organizationId;

    if (!organizationId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const status = req.query.status as 'ACTIVE' | 'PAUSED' | 'ARCHIVED' | undefined;
    const strategies = await listStrategies(organizationId, status);

    res.json(strategies);
  } catch (error) {
    log.error({ error }, 'Failed to list strategies');
    res.status(500).json({ error: 'Failed to list strategies' });
  }
});

/**
 * GET /api/retention/strategies/:id
 * Get a single strategy by ID
 */
router.get('/strategies/:id', async (req: Request, res: Response) => {
  try {
    const strategy = await getStrategy(req.params.id);

    if (!strategy) {
      return res.status(404).json({ error: 'Strategy not found' });
    }

    // Check organization access
    if (strategy.organizationId !== req.user?.organizationId) {
      return res.status(403).json({ error: 'Forbidden' });
    }

    res.json(strategy);
  } catch (error) {
    log.error({ error }, 'Failed to get strategy');
    res.status(500).json({ error: 'Failed to get strategy' });
  }
});

/**
 * PUT /api/retention/strategies/:id
 * Update a strategy
 */
router.put('/strategies/:id', async (req: Request, res: Response) => {
  try {
    const strategy = await updateStrategy(req.params.id, req.body);
    res.json(strategy);
  } catch (error) {
