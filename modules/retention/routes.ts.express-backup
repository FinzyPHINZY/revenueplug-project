/**
 * POST /api/retention/campaigns/trigger
 * Manually trigger a campaign for a customer
 */
router.post('/campaigns/trigger', async (req: Request, res: Response) => {
  try {
    const { strategyId, customerId, triggerType, triggerContext } = req.body;

    const campaign = await triggerCampaign({
      strategyId,
      customerId,
      triggerType,
      triggerContext,
    });

    if (!campaign) {
      return res.status(400).json({ error: 'Campaign not triggered (cooldown or filters)' });
    }

    res.status(201).json(campaign);
  } catch (error) {
    log.error({ error }, 'Failed to trigger campaign');
    res.status(500).json({ error: 'Failed to trigger campaign' });
  }
});

/**
 * GET /api/retention/campaigns
 * List campaigns with filters
 */
router.get('/campaigns', async (req: Request, res: Response) => {
  try {
    const organizationId = req.user?.organizationId;

    if (!organizationId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const {
      status,
      strategyId,
      customerId,
      triggerType,
      limit = '50',
      offset = '0',
    } = req.query;

    const campaigns = await prisma.campaign.findMany({
      where: {
        organizationId,
        ...(status && { status: status as any }),
        ...(strategyId && { strategyId: strategyId as string }),
        ...(customerId && { customerId: customerId as string }),
        ...(triggerType && { triggerType: triggerType as any }),
      },
      include: {
        customer: {
          select: {
            id: true,
            email: true,
            name: true,
          },
        },
        strategy: {
          select: {
            id: true,
            name: true,
          },
        },
        _count: {
          select: {
            actions: true,
          },
        },
      },
      orderBy: { startedAt: 'desc' },
      take: parseInt(limit as string),
      skip: parseInt(offset as string),
    });

    // Get total count
    const total = await prisma.campaign.count({
      where: {
        organizationId,
        ...(status && { status: status as any }),
        ...(strategyId && { strategyId: strategyId as string }),
        ...(customerId && { customerId: customerId as string }),
        ...(triggerType && { triggerType: triggerType as any }),
      },
    });

    res.json({
      campaigns,
      pagination: {
        total,
        limit: parseInt(limit as string),
        offset: parseInt(offset as string),
      },
    });
  } catch (error) {
    log.error({ error }, 'Failed to list campaigns');
    res.status(500).json({ error: 'Failed to list campaigns' });
  }
});

